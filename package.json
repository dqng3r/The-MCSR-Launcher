{
  "name": "mcsr-client",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "dist": "vite build && electron-builder --win -c.nsis.oneClick=false --publish never"
  },
  "build": {
    "appId": "com.mcsr.client",
    "win": {
      "target": "nsis",
      "artifactName": "MCSR-Launcher-Setup.exe"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.263.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0"
  }
}
